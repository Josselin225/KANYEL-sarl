DJANGO_SECRET_KEY=change-me-generate-a-new-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.kanyelsarl.com
CORS_ALLOWED_ORIGINS=https://www.kanyelsarl.com,https://kanyelsarl.com
CSRF_TRUSTED_ORIGINS=https://api.kanyelsarl.com
# Nombre de reverse proxies de confiance devant Django (1 derrière nginx).
DJANGO_NUM_PROXIES=1

# Notifications e-mail (nouveaux messages/candidatures/devis). Laisser vide pour désactiver.
# Gmail : générer un "mot de passe d'application" depuis myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Clé AES-256 des sauvegardes chiffrées. Générer avec :
#   python -c "from content.backup_crypto import generate_key; print(generate_key())"
# et en garder une copie hors du serveur (sans elle, les sauvegardes sont irrécupérables).
BACKUP_ENCRYPTION_KEY=
